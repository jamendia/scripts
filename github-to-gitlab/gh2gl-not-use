#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/gh2gl.py"

if [ -z "$GITHUB_TOKEN" ]; then
    echo "Error: GITHUB_TOKEN is not set."
    echo "Run:"
    echo '  export GITHUB_TOKEN="..."'
    exit 1
fi

if [ -z "$GITLAB_TOKEN" ]; then
    echo "Error: GITLAB_TOKEN is not set."
    echo "Run:"
    echo '  export GITLAB_TOKEN="..."'
    exit 1
fi

if [ -n "$1" ]; then
    REPOSITORY="$1"
else
    read -r -p "GitHub repository (owner/repository): " REPOSITORY
fi

REPOSITORY_URL="https://github.com/$REPOSITORY"

if [ -z "$REPOSITORY_URL" ]; then
    echo "Error: no repository specified."
    exit 1
fi

python3 "$PYTHON_SCRIPT" "$REPOSITORY_URL"
