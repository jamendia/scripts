#!/bin/bash

# MIT license
# mgitstatus v3.5
# Scans multiple directories for git repositories and reports status.

VERSION="3.5"
DEBUG=0

GIT_ID="$(id -u -n)"

usage () {
    cat << EOF >&2

Usage: $0 [--version] [-w] [-e] [-f] [--no-X] [-d N | --depth=N] [DIR [DIR]...]

mgitstatus shows uncommitted, untracked and unpushed changes in multiple Git repositories. By default, mgitstatus scans four directories deep. This can be changed with the -d/--depth option. If DEPTH is 0, the scan is infinitely deep.

  --version            Show version
  -w                   Warn about dirs that are not Git repositories
  -e                   Exclude repos that are 'ok'
  -f                   Do a 'git fetch' on each repo (slow for many repos)
  -c                   Force color output (preserve colors when using pipes)
  -d N, --depth=N      Scan this many directories deep

Limits / filters:
  --no-push
  --no-pull
  --no-upstream
  --no-uncommitted
  --no-untracked
  --no-stashes

EOF
}

# Defaults
WARN_NOT_REPO=0
EXCLUDE_OK=0
DO_FETCH=1          # On by default.
FORCE_COLOR=0
NO_PUSH=0
NO_PULL=0
NO_UPSTREAM=0
NO_UNCOMMITTED=0
NO_UNTRACKED=0
NO_STASHES=0
DEPTH=4

# Parse args
while [ -n "$1" ]; do
    case "$1" in
        --version) echo "v$VERSION"; exit 0 ;;
        -h|--help) usage; exit 1 ;;
        -w) WARN_NOT_REPO=1 ;;
        -e) EXCLUDE_OK=1 ;;
        -f) DO_FETCH=1 ;;
        -c) FORCE_COLOR=1 ;;
        --no-push) NO_PUSH=1 ;;
        --no-pull) NO_PULL=1 ;;
        --no-upstream) NO_UPSTREAM=1 ;;
        --no-uncommitted) NO_UNCOMMITTED=1 ;;
        --no-untracked) NO_UNTRACKED=1 ;;
        --no-stashes) NO_STASHES=1 ;;
        -d) shift; DEPTH="$1" ;;
        --depth=*) DEPTH="${1#--depth=}" ;;
        --depth) shift; DEPTH="$1" ;;
        --) shift; break ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
        *) break ;;
    esac
    shift
done

# Validate numeric depth
case "$DEPTH" in
    ''|*[!0-9]*)
        echo "Invalid value for 'depth' (must be a number): $DEPTH" >&2
        exit 1
        ;;
esac

# Colors Setup
if [ -t 1 ] || [ "${FORCE_COLOR:-0}" -eq 1 ]; then
    C_RED=$'\033[1;31m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_BLUE=$'\033[1;34m'
    C_PURPLE=$'\033[1;35m'
    C_CYAN=$'\033[1;36m'
    C_RESET="$(tput sgr0 2>/dev/null || printf '\033[0m')"
else
    C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_PURPLE="" C_CYAN="" C_RESET=""
fi

# Colors
C_OK="$C_GREEN"
C_LOCKED="$C_PURPLE"
C_NEEDS_PUSH="$C_RED"
C_NEEDS_PULL="$C_BLUE"
C_NEEDS_COMMIT="$C_RED"
C_NEEDS_UPSTREAM="$C_PURPLE"
C_UNTRACKED="$C_CYAN"
C_STASHES="$C_YELLOW"
C_UNSAFE="$C_PURPLE"

if ! command -v git >/dev/null 2>&1; then
    echo "git not found in PATH" >&2
    exit 2
fi

FIND_OPTS=""
if [ "$DEPTH" -ne 0 ]; then
    FIND_OPTS="-maxdepth $DEPTH"
fi

# Iterate over directories
for DIR in "${@:-"."}"; do
    
    # Process substitution avoids subshell execution, keeping scope variables accessible
    while read -r GIT_DIR; do
        PROJ_DIR=$(dirname "$GIT_DIR")

        # Check ownership safely
        if [ -d "$GIT_DIR" ]; then
            GIT_DIR_OWNER="$(stat -c %U "$GIT_DIR")"
            if [ "$GIT_ID" != "$GIT_DIR_OWNER" ]; then
                printf "${PROJ_DIR}: ${C_UNSAFE}unsafe, owned by ${GIT_DIR_OWNER}. Skipping.${C_RESET}\n"
                continue
            fi
        fi

        # Handle gitdir files (git worktrees and submodules)
        if [ -f "$GIT_DIR" ] && [ ! -d "$GIT_DIR" ]; then
            firstline=$(sed -n '1p' "$GIT_DIR" 2>/dev/null || true)
            case "$firstline" in
                gitdir:\ *) real_gitdir=${firstline#gitdir: } ;;
                *) real_gitdir="" ;;
            esac
            if [ -n "$real_gitdir" ]; then
                case "$real_gitdir" in
                    /*) GIT_DIR="$real_gitdir" ;;
                    *) GIT_DIR="$PROJ_DIR/$real_gitdir" ;;
                esac
            fi
        fi

        if [ ! -d "$GIT_DIR" ]; then
            if [ "$WARN_NOT_REPO" -eq 1 ] && [ "$PROJ_DIR" != "." ]; then
                printf "%s: not a git repo\n" "$PROJ_DIR"
            fi
            continue
        fi

        [ "$DEBUG" -eq 1 ] && echo "Inspecting: $GIT_DIR (gitdir: $PROJ_DIR)" >&2

        if [ -f "$GIT_DIR/index.lock" ]; then
            printf "%s: %s Locked. Skipping.%s\n" "$PROJ_DIR" "$C_LOCKED" "$C_RESET"
            continue
        fi

        if [ "$DO_FETCH" -eq 1 ]; then
            git -C "$PROJ_DIR" fetch -q >/dev/null 2>&1 || true
        fi

        git -C "$PROJ_DIR" update-index -q --refresh >/dev/null 2>&1 || true

        # Define arrays natively to replace old /tmp text files
        push_branches=()
        pull_branches=()
        upstream_branches=()

        # Modern branch tracking evaluation using git native formatting engine
        while read -r branch track upstream; do
            [ -z "$branch" ] && continue
            
            if [ "$upstream" = "none" ]; then
                upstream_branches+=("$branch")
            elif [[ "$track" == *ahead* ]]; then
                push_branches+=("$branch")
            elif [[ "$track" == *behind* ]]; then
                pull_branches+=("$branch")
            fi
        done < <(git -C "$PROJ_DIR" for-each-ref --format='%(refname:short) %(upstream:track) %(if)%(upstream)%(then)has_upstream%(else)none%(end)' refs/heads 2>/dev/null)

        # Bash array joining tool using IFS
        join_by_comma() { local IFS=","; echo "$*"; }
        
        NEEDS_PUSH_BRANCHES=$(join_by_comma "${push_branches[@]}")
        NEEDS_PULL_BRANCHES=$(join_by_comma "${pull_branches[@]}")
        NEEDS_UPSTREAM_BRANCHES=$(join_by_comma "${upstream_branches[@]}")

        # Evaluate index state
        if ! git -C "$PROJ_DIR" rev-parse --verify HEAD >/dev/null 2>&1; then
            UNSTAGED=1
            UNCOMMITTED=1
        else
            git -C "$PROJ_DIR" diff-index --quiet HEAD -- 2>/dev/null
            UNSTAGED=$?
            git -C "$PROJ_DIR" diff-files --quiet --ignore-submodules -- 2>/dev/null
            UNCOMMITTED=$?
        fi

        # Extract untracked files count
        UNTRACKED=$(git -C "$PROJ_DIR" ls-files --exclude-standard --others 2>/dev/null)
        
        # Super-fast stash check: count line items natively if file exists
        STASHES=0
        if [ -f "$GIT_DIR/logs/refs/stash" ]; then
            STASHES=$(wc -l < "$GIT_DIR/logs/refs/stash")
        fi

        # Synthesize status flags
        IS_OK=0
        STATUS_NEEDS=""

        if [ -n "$NEEDS_PUSH_BRANCHES" ] && [ "$NO_PUSH" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_PUSH}needs push${C_RESET} " # ( $NEEDS_PUSH_BRANCHES)${C_RESET}
        fi
        if [ -n "$NEEDS_PULL_BRANCHES" ] && [ "$NO_PULL" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_PULL}needs pull${C_RESET} " #( $NEEDS_PULL_BRANCHES)${C_RESET}
        fi
        if [ -n "$NEEDS_UPSTREAM_BRANCHES" ] && [ "$NO_UPSTREAM" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_UPSTREAM}needs upstream${C_RESET} " #( $NEEDS_UPSTREAM_BRANCHES)${C_RESET}
        fi
        if { [ "$UNSTAGED" -ne 0 ] || [ "$UNCOMMITTED" -ne 0 ]; } && [ "$NO_UNCOMMITTED" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_COMMIT}uncommitted changes${C_RESET} "
        fi
        if [ -n "$UNTRACKED" ] && [ "$NO_UNTRACKED" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_UNTRACKED}untracked files${C_RESET} "
        fi
        if [ "$STASHES" -gt 0 ] && [ "$NO_STASHES" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_STASHES}$STASHES stashes${C_RESET} "
        fi
        if [ -z "$STATUS_NEEDS" ]; then
            IS_OK=1
            STATUS_NEEDS="${STATUS_NEEDS}${C_OK}ok${C_RESET} "
        fi

        # Output payload filter
        if [ "$IS_OK" -ne 1 ] || [ "$EXCLUDE_OK" -ne 1 ]; then
            printf "%s: %s\n" "$PROJ_DIR" "$STATUS_NEEDS"
        fi

    done < <(find -L "$DIR" $FIND_OPTS -type d -name .git 2>/dev/null)
done
