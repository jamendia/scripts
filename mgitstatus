#!/usr/bin/env bash

# MIT license
# mgitstatus v2.0 — improved
# Scans multiple directories for git repositories and reports status.

VERSION="2.0"
DEBUG=0

usage () {
    cat << EOF >&2

Usage: $0 [--version] [-w] [-e] [-f] [--no-X] [-d N | --depth=N] [DIR [DIR]...]

mgitstatus shows uncommitted, untracked and unpushed changes in multiple Git repositories. By default, mgitstatus scans four directories deep. This can be changed with the -d/--depth option. If DEPTH is 0, the scan is infinitely deep.

  --version            Show version
  -w                   Warn about dirs that are not Git repositories
  -e                   Exclude repos that are 'ok'
  -f                   Do a 'git fetch' on each repo (slow for many repos)
  -c                   Force color output (preserve colors when using pipes)
  -d N, --depth=N      Scan this many directories deep

Limits / filters:
  --no-push
  --no-pull
  --no-upstream
  --no-uncommitted
  --no-untracked
  --no-stashes

EOF
}

# Defaults
WARN_NOT_REPO=0
EXCLUDE_OK=0
DO_FETCH=1          # On by default.
FORCE_COLOR=0
NO_PUSH=0
NO_PULL=0
NO_UPSTREAM=0
NO_UNCOMMITTED=0
NO_UNTRACKED=0
NO_STASHES=0
DEPTH=4

# Parse args (supports --depth=N and --depth N)
while [ -n "$1" ]; do
    case "$1" in
        --version) echo "v$VERSION"; exit 0 ;;
        -h|--help) usage; exit 1 ;;
        -w) WARN_NOT_REPO=1 ;;
        -e) EXCLUDE_OK=1 ;;
        -f) DO_FETCH=1 ;;
        -c) FORCE_COLOR=1 ;;
        --no-push) NO_PUSH=1 ;;
        --no-pull) NO_PULL=1 ;;
        --no-upstream) NO_UPSTREAM=1 ;;
        --no-uncommitted) NO_UNCOMMITTED=1 ;;
        --no-untracked) NO_UNTRACKED=1 ;;
        --no-stashes) NO_STASHES=1 ;;
        -d)
            shift
            DEPTH="$1"
            ;;
        --depth=*)
            DEPTH="${1#--depth=}"
            ;;
        --depth)
            shift
            DEPTH="$1"
            ;;
        --) shift; break ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            exit 1
            ;;
        *) break ;;
    esac
    shift
done

# Validate numeric depth
case "$DEPTH" in
    ''|*[!0-9]*)
        echo "Invalid value for 'depth' (must be a number): $DEPTH" >&2
        exit 1
        ;;
esac

# Colors - in principle only useful if output is a
# tty or forced, but who knows...
if [ -t 1 ] || [ "${FORCE_COLOR:-0}" -eq 1 ]; then
    C_RED=$'\033[1;31m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_BLUE=$'\033[1;34m'
    C_PURPLE=$'\033[1;35m'
    C_CYAN=$'\033[1;36m'
    C_RESET="$(tput sgr0 2>/dev/null || printf '\033[0m')"
else
    C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_PURPLE="" C_CYAN="" C_RESET=""
fi

C_OK="$C_GREEN"
C_LOCKED="$C_RED"
C_NEEDS_PUSH="$C_YELLOW"
C_NEEDS_PULL="$C_BLUE"
C_NEEDS_COMMIT="$C_RED"
C_NEEDS_UPSTREAM="$C_PURPLE"
C_UNTRACKED="$C_CYAN"
C_STASHES="$C_YELLOW"

# Ensure git exists
if ! command -v git >/dev/null 2>&1; then
    echo "git not found in PATH" >&2
    exit 2
fi

# Find option for find
FIND_OPTS=""
if [ "$DEPTH" -ne 0 ]; then
    FIND_OPTS="$FIND_OPTS -maxdepth $DEPTH"
fi

# Helper: join unique non-empty lines with commas
join_unique_comma() {
    # Reads stdin lines, prints comma-separated unique list or empty string
    awk 'NF { seen[$0]=1 } END { first=1; for (k in seen) { if (!first) printf ","; printf "%s", k; first=0 } }'
}

# Iterate over directories (positional args or ".")
for DIR in "${@:-"."}"; do
    # Find .git directories (follow symlinks too) up to depth
    # We look specifically for entries named ".git" so we avoid iterating all dirs
    # shellcheck disable=SC2086
    find -L "$DIR" $FIND_OPTS -type d -name .git 2>/dev/null | while read -r GIT_DIR; do
        # Resolve project root (parent of .git)
        PROJ_DIR=$(dirname "$GIT_DIR")

        # Handle gitdir files (git worktrees and submodules) where .git is a file
        if [ -f "$GIT_DIR" ] && [ ! -d "$GIT_DIR" ]; then
            # file contains: gitdir: /path/to/real/gitdir
            firstline=$(sed -n '1p' "$GIT_DIR" 2>/dev/null || true)
            case "$firstline" in
                gitdir:\ *) real_gitdir=${firstline#gitdir: } ;;
                *) real_gitdir="" ;;
            esac
            if [ -n "$real_gitdir" ]; then
                # If it is relative, resolve relative to PROJ_DIR
                case "$real_gitdir" in
                    /*) GIT_DIR="$real_gitdir" ;;
                    *) GIT_DIR="$PROJ_DIR/$real_gitdir" ;;
                esac
            fi
        fi

        # Sanity: if there's no git dir, skip
        if [ ! -d "$GIT_DIR" ]; then
            if [ "$WARN_NOT_REPO" -eq 1 ] && [ "$PROJ_DIR" != "." ]; then
                printf "%s: not a git repo\n" "$PROJ_DIR"
            fi
            continue
        fi

        [ "$DEBUG" -eq 1 ] && echo "Inspecting: $PROJ_DIR (gitdir: $GIT_DIR)" >&2

        # Check config mgitstatus.ignore
        GIT_CONF="$GIT_DIR/config"
        if git -C "$PROJ_DIR" config --file "$GIT_CONF" --bool mgitstatus.ignore >/dev/null 2>&1; then
            IGNORE=$(git -C "$PROJ_DIR" config --file "$GIT_CONF" --bool mgitstatus.ignore 2>/dev/null || true)
            if [ "$IGNORE" = "true" ]; then
                [ "$DEBUG" -eq 1 ] && echo "Ignoring $PROJ_DIR per mgitstatus.ignore" >&2
                continue
            fi
        fi

        # Skip if index.lock exists
        if [ -f "$GIT_DIR/index.lock" ]; then
            printf "%s: %sLocked. Skipping.%s\n" "$PROJ_DIR" "$C_LOCKED" "$C_RESET"
            continue
        fi

        # Optional fetch
        if [ "$DO_FETCH" -eq 1 ]; then
            git -C "$PROJ_DIR" fetch -q >/dev/null 2>&1 || true
        fi

        # Refresh index
        git -C "$PROJ_DIR" update-index -q --refresh >/dev/null 2>&1 || true

        NEEDS_PUSH_BRANCHES=""
        NEEDS_PULL_BRANCHES=""
        NEEDS_UPSTREAM_BRANCHES=""

        # Use for-each-ref to list local branches reliably (handles spaces)
        git -C "$PROJ_DIR" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null |
        while read -r REF_HEAD; do
            # Find upstream
            UPSTREAM=$(git -C "$PROJ_DIR" rev-parse --abbrev-ref --symbolic-full-name "$REF_HEAD@{u}" 2>/dev/null || true)
            if [ -n "$UPSTREAM" ]; then
                # Ahead/behind counts
                CNT_AHEAD_BEHIND=$(git -C "$PROJ_DIR" rev-list --left-right --count "$REF_HEAD...$UPSTREAM" 2>/dev/null || true)
                CNT_AHEAD=$(printf "%s" "$CNT_AHEAD_BEHIND" | awk '{ print $1+0 }' 2>/dev/null || printf "0")
                CNT_BEHIND=$(printf "%s" "$CNT_AHEAD_BEHIND" | awk '{ print $2+0 }' 2>/dev/null || printf "0")

                if [ "${CNT_AHEAD:-0}" -gt 0 ]; then
                    printf "%s\n" "$REF_HEAD" >> /tmp/mgit_push_$$ 2>/dev/null || true
                fi
                if [ "${CNT_BEHIND:-0}" -gt 0 ]; then
                    printf "%s\n" "$REF_HEAD" >> /tmp/mgit_pull_$$ 2>/dev/null || true
                fi

                REV_LOCAL=$(git -C "$PROJ_DIR" rev-parse --verify "$REF_HEAD" 2>/dev/null || true)
                REV_REMOTE=$(git -C "$PROJ_DIR" rev-parse --verify "$UPSTREAM" 2>/dev/null || true)
                REV_BASE=$(git -C "$PROJ_DIR" merge-base "$REF_HEAD" "$UPSTREAM" 2>/dev/null || true)

                if [ -n "$REV_LOCAL" ] && [ -n "$REV_REMOTE" ] && [ -n "$REV_BASE" ]; then
                    if [ "$REV_LOCAL" = "$REV_REMOTE" ]; then
                        :
                    else
                        if [ "$REV_LOCAL" = "$REV_BASE" ]; then
                            printf "%s\n" "$REF_HEAD" >> /tmp/mgit_pull_$$ 2>/dev/null || true
                        fi
                        if [ "$REV_REMOTE" = "$REV_BASE" ]; then
                            printf "%s\n" "$REF_HEAD" >> /tmp/mgit_push_$$ 2>/dev/null || true
                        fi
                    fi
                fi
            else
                printf "%s\n" "$REF_HEAD" >> /tmp/mgit_upstream_$$ 2>/dev/null || true
            fi
        done

        # Aggregate and dedupe branch lists (if files exist)
        if [ -f /tmp/mgit_push_$$ ]; then
            NEEDS_PUSH_BRANCHES=$(sort -u /tmp/mgit_push_$$ 2>/dev/null | join_unique_comma)
            rm -f /tmp/mgit_push_$$
        fi
        if [ -f /tmp/mgit_pull_$$ ]; then
            NEEDS_PULL_BRANCHES=$(sort -u /tmp/mgit_pull_$$ 2>/dev/null | join_unique_comma)
            rm -f /tmp/mgit_pull_$$
        fi
        if [ -f /tmp/mgit_upstream_$$ ]; then
            NEEDS_UPSTREAM_BRANCHES=$(sort -u /tmp/mgit_upstream_$$ 2>/dev/null | join_unique_comma)
            rm -f /tmp/mgit_upstream_$$
        fi

        # Find unstaged / uncommitted / untracked / stashes
        git -C "$PROJ_DIR" update-index -q --refresh >/dev/null 2>&1 || true
        git -C "$PROJ_DIR" rev-parse --verify HEAD >/dev/null 2>&1
        HAS_HEAD=$?
        if [ "$HAS_HEAD" -ne 0 ]; then
            # No commits yet: treat everything as uncommitted/untracked
            UNSTAGED=1
            UNCOMMITTED=1
        else
            git -C "$PROJ_DIR" diff-index --quiet HEAD -- 2>/dev/null
            UNSTAGED=$?
            git -C "$PROJ_DIR" diff-files --quiet --ignore-submodules -- 2>/dev/null
            UNCOMMITTED=$?
        fi

        UNTRACKED=$(git -C "$PROJ_DIR" ls-files --exclude-standard --others 2>/dev/null || true)
        STASHES=$(git -C "$PROJ_DIR" stash list 2>/dev/null | wc -l | tr -d ' ')

        # Set the status
        IS_OK=0  # 0 = Repo needs something, 1 = Repo needs nothing ('ok')
        STATUS_NEEDS=""

        if [ -n "$NEEDS_PUSH_BRANCHES" ] && [ "$NO_PUSH" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_PUSH}Needs push ($NEEDS_PUSH_BRANCHES)${C_RESET} "
        fi
        if [ -n "$NEEDS_PULL_BRANCHES" ] && [ "$NO_PULL" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_PULL}Needs pull ($NEEDS_PULL_BRANCHES)${C_RESET} "
        fi
        if [ -n "$NEEDS_UPSTREAM_BRANCHES" ] && [ "$NO_UPSTREAM" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_UPSTREAM}Needs upstream ($NEEDS_UPSTREAM_BRANCHES)${C_RESET} "
        fi

        # Fix operator precedence — group tests so they work as intended:
        if { [ "$UNSTAGED" -ne 0 ] || [ "$UNCOMMITTED" -ne 0 ]; } && [ "$NO_UNCOMMITTED" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_NEEDS_COMMIT}Uncommitted changes${C_RESET} "
        fi
        if [ -n "$UNTRACKED" ] && [ "$NO_UNTRACKED" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_UNTRACKED}Untracked files${C_RESET} "
        fi
        if [ -n "$STASHES" ] && [ "$STASHES" -ne 0 ] && [ "$NO_STASHES" -eq 0 ]; then
            STATUS_NEEDS="${STATUS_NEEDS}${C_STASHES}$STASHES Stashes${C_RESET} "
        fi
        if [ -z "$STATUS_NEEDS" ]; then
            IS_OK=1
            STATUS_NEEDS="${STATUS_NEEDS}${C_OK}ok${C_RESET} "
        fi

        # Print unless excluded
        if [ "$IS_OK" -ne 1 ] || [ "$EXCLUDE_OK" -ne 1 ]; then
            printf "%s: %s\n" "$PROJ_DIR" "$STATUS_NEEDS"
        fi
    done
done
